{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:groundwork:schema:map:1",
  "title": "Groundwork map",
  "description": "A curriculum as a graph: layers of nodes (topics) linked by prerequisites. Referential integrity and cycle checks are enforced by the app, not by this schema.",
  "type": "object",
  "required": ["schema", "id", "title", "version", "layers", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "groundwork/map@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Semantic version. Renaming or removing nodes, or reordering objectives, is a major version."
    },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Must be a string. Quote numeric-looking ids in YAML (\"2.10\", not 2.10)."
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "layer": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["title", "kind"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "kind": { "enum": ["book", "course", "docs", "video", "article", "practice", "tool"] },
        "free": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "title", "layer", "depth", "why", "objectives", "strong_when"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "layer": { "$ref": "#/$defs/id" },
        "depth": {
          "enum": ["working", "deep"],
          "description": "Target depth: working = build it with docs open; deep = build and debug it unaided."
        },
        "why": { "type": "string", "minLength": 1 },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Stored in progress by position, so reordering is a breaking change."
        },
        "strong_when": { "type": "string", "minLength": 1 },
        "requires": {
          "$ref": "#/$defs/idList",
          "description": "Hard prerequisites: each must reach working before this node unlocks."
        },
        "related": {
          "$ref": "#/$defs/idList",
          "description": "Soft links: suggested, never blocking."
        },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "est_hours": { "type": "number", "minimum": 0 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "requires"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "requires": {
          "allOf": [{ "$ref": "#/$defs/idList" }, { "type": "array", "minItems": 1 }]
        }
      }
    }
  }
}
